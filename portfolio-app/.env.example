# Vorlage für .env.local – kopieren mit: cp .env.example .env.local
# .env.local wird nie eingecheckt.

# Kursanbieter: yahoo (Standard, ohne Key), finnhub, fmp, alphavantage oder mock (simulierte Demo-Kurse)
MARKET_DATA_PROVIDER=yahoo

# Wechselkurse: ecb (EZB-Referenzkurse) oder mock
# FX_PROVIDER=ecb

# API-Keys (nur für den jeweiligen Anbieter nötig)
# FINNHUB_API_KEY=
# FMP_API_KEY=
# ALPHAVANTAGE_API_KEY=

# Beim allerersten Start keine Beispieldaten laden
# SEED_ON_FIRST_RUN=false

# Zusätzlich erlaubte Hostnamen (z. B. lokaler Reverse-Proxy), kommagetrennt
# ALLOWED_HOSTS=
