{
  "name": "portfolio-app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "tsx scripts/setup.ts",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "prestart": "tsx scripts/setup.ts",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "prettier --check . && eslint && tsc --noEmit && vitest run",
    "db:reset": "tsx scripts/reset.ts",
    "db:generate": "drizzle-kit generate",
    "research:refresh": "tsx scripts/research-refresh.ts",
    "research:texts": "tsx scripts/research-texts.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "app:build": "node scripts/app-build.mjs",
    "app:install": "node scripts/app-install.mjs",
    "app:dev": "cross-env DEPOT_URL=http://127.0.0.1:3000 electron ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yahoo-finance2": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "description": "Lokale Portfolio- und Trading-App (Tracking & Analyse, keine Orders)",
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "local.depot.portfolio",
    "productName": "Depot",
    "copyright": "Alle Daten bleiben auf diesem Mac – keine Anlageberatung",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      ".next/**",
      "!.next/cache/**",
      "!.next/dev/**",
      "!.next/types/**",
      "!.next/trace*",
      "public/**",
      "drizzle/**",
      "config/**",
      "content/**",
      "electron/**",
      "next.config.ts",
      ".env.example",
      "package.json",
      "!node_modules/better-sqlite3/{deps,src}/**"
    ],
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dir"
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "files": [
        "!node_modules/better-sqlite3/prebuilds/{linux,linuxmusl,win32}-*.node"
      ]
    }
  }
}
